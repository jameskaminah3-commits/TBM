{
  "name": "zaina-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zaina as a product: the engine behind TBM's concierge, run as its own service so it can serve other businesses.",
  "scripts": {
    "dev": "cd .. && tsx zaina-platform/src/server.ts",
    "start": "cd .. && node zaina-platform/dist/server.js",
    "build": "cd .. && esbuild zaina-platform/src/server.ts --platform=node --packages=external --bundle --format=esm --outdir=zaina-platform/dist",
    "migrate": "cd .. && tsx zaina-platform/src/db/migrate-cli.ts",
    "test": "cd .. && tsx --test --test-concurrency=1 zaina-platform/test/unit/*.test.ts",
    "test:db": "cd .. && tsx --test --test-concurrency=1 zaina-platform/test/db/*.test.ts",
    "check": "cd .. && tsc -p zaina-platform/tsconfig.json",
    "test:e2e": "cd .. && tsx --test --test-concurrency=1 zaina-platform/test/e2e/e2e.test.ts",
    "staff:create": "cd .. && tsx zaina-platform/src/cli/create-staff.ts",
    "knowledge:import": "cd .. && tsx zaina-platform/src/cli/import-knowledge.ts",
    "eval": "cd .. && tsx zaina-platform/test/eval/run.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.39.1",
    "express": "^4.21.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  }
}
