{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --prefix zaina-platform",
    "watchPatterns": ["zaina-platform/**", "server/**", "shared/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "preDeployCommand": "npm run release --prefix zaina-platform",
    "startCommand": "npm start --prefix zaina-platform",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
